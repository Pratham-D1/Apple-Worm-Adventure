# ==========================================
# Apple Worm Adventure - Backend Environment Template
# ==========================================
# Copy this file to server/.env:
#   cp .env.example .env (Linux/Mac)
#   Copy-Item .env.example .env (Windows PowerShell)

# HTTP server port
PORT=5000

# MongoDB Atlas connection string (use replica set / Atlas URI with credentials)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/apple_worm_adventure?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/apple_worm_adventure?retryWrites=true&w=majority

# Name of the MongoDB database
DB_NAME=apple_worm_adventure

# JWT signing secret (use a cryptographically random string >= 32 characters in production)
JWT_SECRET=replace_with_a_long_random_secret_string

# Frontend Client URL for CORS verification
# For local development: http://localhost:5173
# For production deployment: https://your-app.vercel.app
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Game Branding Name
GAME_NAME="Apple Worm Adventure"

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development
