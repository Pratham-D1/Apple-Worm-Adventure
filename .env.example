# ==========================================
# Apple Worm Adventure - Project Environment Reference
# ==========================================
# This file lists all environment variables across frontend and backend.
# Separate .env files should be created inside client/ and server/ directories.

# ------------------------------------------
# Backend Variables (server/.env)
# ------------------------------------------
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/apple_worm_adventure?retryWrites=true&w=majority
DB_NAME=apple_worm_adventure
JWT_SECRET=replace_with_a_long_random_secret_string
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
GAME_NAME="Apple Worm Adventure"
NODE_ENV=development

# ------------------------------------------
# Frontend Variables (client/.env)
# ------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_GAME_NAME="Apple Worm Adventure"
