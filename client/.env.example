# ==========================================
# Apple Worm Adventure - Frontend Environment Template
# ==========================================
# Copy this file to client/.env:
#   cp .env.example .env (Linux/Mac)
#   Copy-Item .env.example .env (Windows PowerShell)

# Backend API base URL (Vite exposes variables prefixed with VITE_)
VITE_API_URL=http://localhost:5000/api

# Game display branding name
VITE_GAME_NAME="Apple Worm Adventure"
